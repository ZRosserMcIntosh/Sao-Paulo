{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/sao-paulo/",
      "permanent": false
    },
    {
      "source": "/sao-paulo",
      "destination": "/sao-paulo/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/driving",
      "destination": "/sao-paulo/driving/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/flying",
      "destination": "/sao-paulo/flying/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/golf",
      "destination": "/sao-paulo/golf/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/physics",
      "destination": "/sao-paulo/physics/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sao-paulo/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sao-paulo/driving/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sao-paulo/flying/(.*\\.wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sao-paulo/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
