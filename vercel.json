{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/sao-paulo/",
      "permanent": false
    },
    {
      "source": "/sao-paulo",
      "destination": "/sao-paulo/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/driving",
      "destination": "/sao-paulo/driving/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/flying",
      "destination": "/sao-paulo/flying/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/golf",
      "destination": "/sao-paulo/golf/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/glass",
      "destination": "/sao-paulo/glass/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/physics",
      "destination": "/sao-paulo/physics/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/vehicle-dynamics",
      "destination": "/sao-paulo/vehicle-dynamics/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/liquids",
      "destination": "/sao-paulo/liquids/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/wake",
      "destination": "/sao-paulo/wake/",
      "permanent": true
    },
    {
      "source": "/sao-paulo/destruction",
      "destination": "/sao-paulo/destruction/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sao-paulo/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sao-paulo/driving/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sao-paulo/flying/(.*\\.wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sao-paulo/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sao-paulo/glass/(.*\\.wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sao-paulo/liquids/(.*\\.wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sao-paulo/glass/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/sao-paulo/glass",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/sao-paulo/destruction/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
