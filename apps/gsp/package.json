{
  "name": "georgia-state-pursuit",
  "private": true,
  "version": "0.1.0",
  "description": "Georgia State Pursuit \u2014 a browser vehicle-physics and police-pursuit demonstrator on the site's physics engines.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "engines": "node scripts/sync-engines.mjs",
    "dev": "npm run engines && next dev -p 3210",
    "build": "npm run engines && next build",
    "deploy": "npm run build && node scripts/deploy-to-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/headless.mjs 6 && node tests/pursuit.mjs B 60 1",
    "test:pursuit": "node tests/pursuit.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "next": "^16.4.6",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
